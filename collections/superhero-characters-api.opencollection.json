      "info": {
        "name": "Characters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get character by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://superheroapi.com/api.php/:access-token/:id",
            "params": [
              {
                "name": "access-token",
                "value": "",
                "type": "path",
                "description": "API access token obtained by logging in with GitHub at superheroapi.com."
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Numeric character ID (1–731)."
              }
            ]
          },
          "docs": "Returns the complete character record for the superhero or villain identified by the numeric ID, including all sub-sections (powerstats, biography, appearance, work, connections, image)."
        },
        {
          "info": {
            "name": "Get character power stats",
            "type": "http"
